    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.5",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "msw": "2.4.9",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
