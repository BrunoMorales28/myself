# Copy to .env.local and fill in real values. Never commit .env.local.
# Variables are added here as each feature that needs them is implemented (see /specs).

# spec 16 — Contact backend (Postgres via Vercel's Neon integration).
# Auto-injected into Vercel's project env vars once a Postgres database is
# linked in the Vercel dashboard; for local dev, pull them with
# `vercel env pull .env.local` or copy them from the dashboard by hand.
POSTGRES_URL=
